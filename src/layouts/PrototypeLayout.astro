---
// Лёгкий layout для прототипов главной: без общего SiteShell (шапку рисует сам макет),
// со своими шрифтами и noindex.
import "../styles/global.css";

export interface Props {
  title: string;
  /** URL стилей Google Fonts для конкретного макета. */
  fonts?: string;
  bodyClass?: string;
}

const { title, fonts, bodyClass = "" } = Astro.props;
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    {
      fonts && (
        <>
          <link rel="preconnect" href="https://fonts.googleapis.com" />
          <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
          <link href={fonts} rel="stylesheet" />
        </>
      )
    }
  </head>
  <body class={`bg-white ${bodyClass}`}>
    <slot />
  </body>
</html>
