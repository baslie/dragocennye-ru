---
import "../styles/global.css";

export interface Props {
  title?: string;
  description?: string;
  /** OG / canonical-путь, например "/catalog/sapfir" */
  path?: string;
}

const {
  title = "Драгоценные — коллекция цветных камней",
  description =
    "Интернет-магазин коллекционных драгоценных камней гемолога Дмитрия Салятова: каждый камень в единственном экземпляре, с крупными фото, видео и полным паспортом характеристик.",
  path,
} = Astro.props;

const canonical = path ? new URL(path, Astro.site ?? "https://dragocennye.example").href : undefined;
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="ru_RU" />
    {canonical && <meta property="og:url" content={canonical} />}

    <!-- Шрифты: Noto Sans (заголовки + body) + Noto Sans Mono (мета) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Sans:wght@300;400;500;600;700;800&family=Noto+Sans+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-white text-stone-900">
    <slot />
  </body>
</html>
