---
import "../styles/global.css";
import { SiteShell } from "../components/shell/SiteShell";
import type { SearchItem } from "../components/search/SearchModal";
import { stones, getVariety, colors, photoFor } from "../data";

export interface Props {
  title?: string;
  description?: string;
  /** OG / canonical-путь, например "/catalog/sapfir" */
  path?: string;
}

const {
  title = "Драгоценные — коллекция цветных камней",
  description =
    "Интернет-магазин коллекционных драгоценных камней гемолога Дмитрия Салятова: каждый камень в единственном экземпляре, с крупными фото, видео и полным паспортом характеристик.",
  path,
} = Astro.props;

const site = Astro.site ?? new URL("https://dragocennye.example");
const canonical = path ? new URL(path, site).href : undefined;
const currentPath = Astro.url.pathname;

// Поисковый индекс для модалки поиска (строится на сборке, в клиент уходит только это).
const colorById = new Map(colors.map((c) => [c.id, c]));
const searchItems: SearchItem[] = stones.map((s) => {
  const variety = getVariety(s.varietyId);
  const color = colorById.get(s.colorId);
  return {
    slug: s.slug,
    name: s.name,
    varietyName: variety?.name ?? "",
    colorName: color?.name ?? "",
    colorHex: color?.hex ?? "#576A8F",
    price: s.price,
    weightCt: s.weightCt,
    photoUrl: photoFor(s),
  };
});
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="ru_RU" />
    {canonical && <meta property="og:url" content={canonical} />}

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Spectral:ital,wght@0,300;0,400;1,300;1,400&family=Onest:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-white text-ink antialiased">
    <SiteShell client:load currentPath={currentPath} searchItems={searchItems}>
      <slot />
    </SiteShell>
  </body>
</html>
