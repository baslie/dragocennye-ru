---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { withBase } from "../../lib/format";
import { BlogPost } from "../../components/blog/BlogPost";
import {
  posts as allPosts,
  getPostBySlug,
  getVariety,
  gemologist,
  mentionedStonesForPost,
  relatedPosts,
  toPostCard,
} from "../../data";

export function getStaticPaths() {
  return allPosts.map((p) => ({ params: { slug: p.slug } }));
}

const { slug } = Astro.params;
const post = getPostBySlug(slug!);
if (!post) return Astro.redirect("/404");

const fullPost = { ...post, mentionedStones: mentionedStonesForPost(post) };

const author = {
  name: gemologist.name,
  role: gemologist.role,
  portraitUrl: gemologist.portraitUrl,
};

const related = relatedPosts(post, 3).map(toPostCard);

const primaryVariety = getVariety(post.varietyIds[0]);
const catalogHref = withBase(primaryVariety ? `/catalog/${primaryVariety.slug}` : "/");

const title = `${post.title} | Журнал «Драгоценные»`;
const description = post.lead ?? post.excerpt;
---

<BaseLayout title={title} description={description} path={`/blog/${post.slug}`}>
  <BlogPost post={fullPost} author={author} relatedPosts={related} catalogHref={catalogHref} />
</BaseLayout>
