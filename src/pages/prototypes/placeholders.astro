---
import PrototypeLayout from "../../layouts/PrototypeLayout.astro";
import { Placeholders } from "../../prototypes/placeholders/Placeholders";
import { prototypeData } from "../../prototypes/pageData";

const { stones, varieties, colors } = prototypeData();
// Камни без фото пока отличаются только тем, что вместо снимка лежит общая PNG-иконка фотоаппарата.
// Чёрные камни в конец: на них свечение цвета выглядит просто серым пятном.
const noPhoto = stones
  .filter((s) => s.photoUrl.endsWith(".png"))
  .sort((a, b) => Number(a.colorId === "col-black") - Number(b.colorId === "col-black"));
const withPhoto = stones.filter((s) => !s.photoUrl.endsWith(".png"));
// Для соседей берём по камню разных видов, чтобы ряды не были однообразными.
const photoStones = varieties
  .map((v) => withPhoto.find((s) => s.varietyId === v.id))
  .filter((s) => s !== undefined);
---

<PrototypeLayout
  title="Заполнитель без фото"
  fonts="https://fonts.googleapis.com/css2?family=Spectral:ital,wght@0,300;0,400;1,300;1,400&family=Onest:wght@400;500&display=swap"
>
  <Placeholders
    photoStones={photoStones}
    noPhotoStones={noPhoto}
    varietyNames={Object.fromEntries(varieties.map((v) => [v.id, v.name]))}
    colorHex={Object.fromEntries(colors.map((c) => [c.id, c.hex]))}
  />
</PrototypeLayout>
