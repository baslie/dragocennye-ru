---
import PrototypeLayout from "../../layouts/PrototypeLayout.astro";

const variants = [
  {
    href: "/prototypes/home-a",
    letter: "A",
    title: "Ювелирный дом",
    text: "Журнальная подача: антиква Cormorant Garamond, чёрный на белом, изумрудный акцент. Виды камней списком-индексом, крупные фото в три колонки.",
    fonts: "Cormorant Garamond + Manrope",
  },
  {
    href: "/prototypes/home-b",
    letter: "B",
    title: "Галерея",
    text: "Строгая сетка и камни как лоты: гротеск Onest, моноширинные подписи, коралловый акцент. Фильтры в боковой колонке, плотная витрина.",
    fonts: "Onest + IBM Plex Mono",
  },
  {
    href: "/prototypes/home-c",
    letter: "C",
    title: "Свет и стекло",
    text: "Подход Apple: стеклянная капсула-навигация, скруглённые плитки, крупная первая карточка, мягкие отклики на наведение и нажатие.",
    fonts: "Inter Tight",
  },
];
---

<PrototypeLayout
  title="Макеты главной"
  fonts="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600&display=swap"
>
  <main class="mx-auto max-w-5xl px-5 py-16 md:py-24" style="font-family: Manrope, system-ui, sans-serif; color: #121314">
    <h1 class="text-4xl font-semibold tracking-tight md:text-5xl">Три макета главной</h1>
    <p class="mt-4 max-w-[60ch] text-[15px] leading-relaxed text-black/60">
      Все макеты работают на реальном каталоге: переключаются виды камней, фильтры по цвету и цене,
      сортировка и «Показать ещё». Карточки ведут на настоящие страницы камней.
    </p>
    <ul class="mt-12 divide-y divide-black/10 border-y border-black/10">
      {
        variants.map((v) => (
          <li>
            <a href={v.href} class="group grid gap-4 py-8 md:grid-cols-[80px_1fr_auto] md:items-baseline">
              <span class="text-5xl font-light text-black/25 transition-colors group-hover:text-black">{v.letter}</span>
              <span>
                <span class="block text-2xl font-semibold">{v.title}</span>
                <span class="mt-2 block max-w-[62ch] text-[15px] leading-relaxed text-black/60">{v.text}</span>
                <span class="mt-3 block text-[13px] text-black/45">{v.fonts}</span>
              </span>
              <span class="text-[14px] underline underline-offset-4">Открыть</span>
            </a>
          </li>
        ))
      }
    </ul>
  </main>
</PrototypeLayout>
