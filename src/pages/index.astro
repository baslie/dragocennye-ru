---
import BaseLayout from "../layouts/BaseLayout.astro";
import { CatalogBrowseIsland } from "../components/catalog/CatalogBrowseIsland";
import {
  allCatalogStones,
  catalogVarieties,
  cuts,
  origins,
  treatments,
  colors,
  certificates,
} from "../data";

const stones = allCatalogStones();
const varieties = catalogVarieties();
---

<BaseLayout path="/">
  <CatalogBrowseIsland
    client:load
    stones={stones}
    varieties={varieties}
    cuts={cuts}
    origins={origins}
    treatments={treatments}
    colors={colors}
    certificates={certificates}
  />
</BaseLayout>
