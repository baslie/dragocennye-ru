---
import BaseLayout from "../layouts/BaseLayout.astro";
import { CatalogPage } from "../components/catalog/CatalogPage";
import { allCatalogStones, indexVarieties, heroSlides, cuts, origins, treatments, colors } from "../data";
---

<BaseLayout path="/">
  <CatalogPage
    client:load
    intro={{ kind: "home", slides: heroSlides() }}
    stones={allCatalogStones()}
    varieties={indexVarieties()}
    colors={colors}
    cuts={cuts}
    origins={origins}
    treatments={treatments}
  />
</BaseLayout>
