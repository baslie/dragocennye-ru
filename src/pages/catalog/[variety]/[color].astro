---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { withBase } from "../../../lib/format";
import { CatalogPage } from "../../../components/catalog/CatalogPage";
import {
  allCatalogStones,
  catalogVarieties,
  colorsForVariety,
  indexVarieties,
  getVarietyBySlug,
  getColorBySlug,
  capitalize,
  pluralColor,
  cuts,
  origins,
  treatments,
  colors,
} from "../../../data";

export function getStaticPaths() {
  return catalogVarieties().flatMap((v) =>
    colorsForVariety(v.id).map((c) => ({
      params: { variety: v.slug, color: c.slug },
    })),
  );
}

const { variety: varietySlug, color: colorSlug } = Astro.params;
const variety = getVarietyBySlug(varietySlug!);
const color = getColorBySlug(colorSlug!);
if (!variety || !color) return Astro.redirect("/404");

const varietyHeading = capitalize(variety.pluralName);
const heading = `${pluralColor(color.name)} ${variety.pluralName}`;
const title = `${color.name} ${variety.name.toLowerCase()} — купить | Драгоценные`;
const description = `${heading} из коллекции гемолога Дмитрия Салятова: каждый камень в единственном экземпляре, с фото, видео и паспортом характеристик. Подбор по тону, чистоте и огранке.`;
const paragraphs = [variety.shortDescription.split("\n\n")[0]];
---

<BaseLayout title={title} description={description} path={`/catalog/${variety.slug}/${color.slug}`}>
  <CatalogPage
    client:load
    intro={{
      kind: "variety",
      title: heading,
      paragraphs,
      crumbs: [{ label: "Каталог", href: withBase("/") }, { label: varietyHeading, href: withBase(`/catalog/${variety.slug}`) }, { label: pluralColor(color.name) }],
    }}
    varietyId={variety.id}
    routeColorId={color.id}
    stones={allCatalogStones()}
    varieties={indexVarieties()}
    colors={colors}
    cuts={cuts}
    origins={origins}
    treatments={treatments}
  />
</BaseLayout>
