---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { CatalogPage } from "../../components/catalog/CatalogPage";
import {
  allCatalogStones,
  catalogVarieties,
  indexVarieties,
  getVarietyBySlug,
  capitalize,
  cuts,
  origins,
  treatments,
  colors,
} from "../../data";

export function getStaticPaths() {
  return catalogVarieties().map((v) => ({ params: { variety: v.slug } }));
}

const { variety: varietySlug } = Astro.params;
const variety = getVarietyBySlug(varietySlug!);
if (!variety) return Astro.redirect("/404");

const heading = capitalize(variety.pluralName);
const paragraphs = variety.shortDescription.split("\n\n");
const title = `${heading} — купить коллекционный камень | Драгоценные`;
const description = paragraphs[0];
---

<BaseLayout title={title} description={description} path={`/catalog/${variety.slug}`}>
  <CatalogPage
    client:load
    intro={{ kind: "variety", title: heading, paragraphs, crumbs: [{ label: "Каталог", href: "/" }, { label: heading }] }}
    varietyId={variety.id}
    stones={allCatalogStones()}
    varieties={indexVarieties()}
    colors={colors}
    cuts={cuts}
    origins={origins}
    treatments={treatments}
  />
</BaseLayout>
