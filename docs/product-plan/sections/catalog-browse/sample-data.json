  "varieties": [
    {
      "id": "v-sapfir",
      "slug": "sapfir",
      "name": "Сапфир",
      "imageUrl": "/sections/catalog-browse/varieties/sapfir.jpg",
      "stoneCount": 52,
      "shortDescription": "Сапфир — корундовая группа самоцветов всех оттенков, кроме красного: классический синий, зелёный, жёлтый, розовый, фиолетовый и редкая падпараджа. Твёрдость 9 по Моосу делает сапфир одним из самых износостойких драгоценных камней для повседневного ношения.\n\nВ коллекции Дмитрия — экземпляры из Танзании, Шри-Ланки, Мадагаскара и Африки, большинство с полным паспортом: вес, огранка, чистота, обработка."
    },
    {
      "id": "v-shpinel",
      "slug": "shpinel",
      "name": "Шпинель",
      "imageUrl": "/sections/catalog-browse/varieties/shpinel.jpg",
      "stoneCount": 25,
      "shortDescription": "Шпинель исторически путали с рубином — «Рубин Чёрного принца» в короне Британии оказался именно шпинелью. Сегодня ценится за чистые тона от розового и красного до фиолетового и кобальтового синего.\n\nЛучшие экземпляры идут из Бирмы и Танзании, в коллекции также есть вишнёвые и пастельно-розовые камни из Мадагаскара."
    },
    {
      "id": "v-turmalin",
      "slug": "turmalin",
      "name": "Турмалин",
      "imageUrl": "/sections/catalog-browse/varieties/turmalin.jpg",
      "stoneCount": 26,
      "shortDescription": "Турмалин — самый разнообразный по цветам камень в коллекции: хромдравиты, индиголиты, рубеллиты, верделиты и особо ценные параиба-турмалины с неоновым голубым свечением. Часто встречаются двухцветные и арбузные экземпляры.\n\nОсновные источники — Бразилия, Мозамбик, Нигерия, Афганистан."
    },
    {
      "id": "v-granat",
      "slug": "granat",
      "name": "Гранат",
      "imageUrl": "/sections/catalog-browse/varieties/granat.jpg",
      "stoneCount": 18,
      "shortDescription": "Гранат — это не один камень, а целое семейство: огненный спессартин, вишнёвый родолит, ярко-зелёный цаворит и редчайший меняющий цвет гранат из Восточной Африки. Все грантаы природного происхождения и не требуют облагораживания.\n\nЛучшие цавориты — из Кении и Танзании, спессартины — из Намибии и Мозамбика."
    },
    {
      "id": "v-cirkon",
      "slug": "cirkon",
      "name": "Циркон",
      "imageUrl": "/sections/catalog-browse/varieties/cirkon.jpg",
      "stoneCount": 15,
      "shortDescription": "Натуральный циркон — это древнейший минерал на Земле, не имеющий ничего общего с синтетическим кубическим цирконием. Обладает алмазоподобным блеском и высокой дисперсией, что даёт яркие «огоньки» в огранке.\n\nВ коллекции — голубые, золотистые и бесцветные цирконы из Камбоджи, Шри-Ланки и Танзании."
    },
    {
      "id": "v-beryll",
      "slug": "beryll",
      "name": "Берилл",
      "imageUrl": "/sections/catalog-browse/varieties/beryll.jpg",
      "stoneCount": 8,
      "shortDescription": "Группа берилла включает изумруд, аквамарин, морганит, гелиодор и благородные зелёные бериллы. Все они — один минерал с разными примесями, которые и дают окраску.\n\nВ коллекции представлены аквамарины из Бразилии и Мадагаскара, жёлтые гелиодоры и редкие розовые морганиты."
    },
    {
      "id": "v-kvarz",
      "slug": "kvarz",
      "name": "Кварц",
      "imageUrl": "/sections/catalog-browse/varieties/kvarz.jpg",
      "stoneCount": 19,
      "shortDescription": "Ювелирный кварц — это аметист, цитрин, раухтопаз, морион, розовый кварц и редкий аметрин с природным переходом фиолетового в жёлтый. Крупные чистые экземпляры — редкость и коллекционная ценность.\n\nОсновные источники — Бразилия, Уругвай, Мадагаскар."
    },
    {
      "id": "v-opal",
      "slug": "opal",
      "name": "Опал",
      "imageUrl": "/sections/catalog-browse/varieties/opal.jpg",
      "stoneCount": 11,
      "shortDescription": "Опал ценится за уникальную игру цвета — опалесценцию, когда по камню при повороте бегут радужные всполохи. Белые, чёрные и огненные опалы — три основных типа в коллекции.\n\nЛучшие чёрные опалы — из австралийского Лайтнинг-Ридж, огненные — из Мексики и Эфиопии."
    },
    {
      "id": "v-topaz",
      "slug": "topaz",
      "name": "Топаз",
      "imageUrl": "/sections/catalog-browse/varieties/topaz.jpg",
      "stoneCount": 13,
      "shortDescription": "Топаз встречается в природе в широком спектре: бесцветный, голубой, жёлтый, медовый, розовый, а также особо ценный императорский топаз с оранжево-красным переливом.\n\nВ коллекции — голубые топазы Sky и London Blue из Бразилии, жёлтые и шерри-топазы из Шри-Ланки."
    },
    {
      "id": "v-tanzanit",
      "slug": "tanzanit",
      "name": "Танзанит",
      "imageUrl": "/sections/catalog-browse/varieties/tanzanit.jpg",
      "stoneCount": 3,
      "shortDescription": "Танзанит — редкий разновидность цоизита, добываемый в единственном месте на планете: у подножия Килиманджаро в Танзании. Плеохроизм даёт переход от глубокого синего к фиолетовому при повороте камня.\n\nЗапасы месторождения ограничены, поэтому танзанит считается одним из самых перспективных инвестиционных камней."
    }
  ],
